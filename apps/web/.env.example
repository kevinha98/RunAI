# ─── LLM: Radical Gateway (gateway.raicode.no/v1) ─────────────────────────────
# Get your token from the Radical Gateway portal.
# Azure AD alternative: run `az login` and set the bearer token here.
RADICAL_GATEWAY_TOKEN=your_gateway_token_here

# Fallback: direct Anthropic API (only used if RADICAL_GATEWAY_TOKEN is unset)
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Strava OAuth 2.0 ──────────────────────────────────────────────────────────
# Register your app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Populated after first OAuth flow (stored server-side only)
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
STRAVA_TOKEN_EXPIRES_AT=

# Base URL used for OAuth callback (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Strava Webhooks ───────────────────────────────────────────────────────────
# Choose any secret string — must match what you pass when calling /api/strava/subscribe
STRAVA_WEBHOOK_VERIFY_TOKEN=your_verify_token_here

