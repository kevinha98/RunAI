# ─── LLM: Radical Gateway (gateway.raicode.no/v1) ─────────────────────────────
# Get your token from the Radical Gateway portal.
# Azure AD alternative: run `az login` and set the bearer token here.
RADICAL_GATEWAY_TOKEN=your_gateway_token_here

# Fallback: direct Anthropic API (only used if RADICAL_GATEWAY_TOKEN is unset)
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

