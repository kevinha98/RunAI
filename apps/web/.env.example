# ─── LLM ───────────────────────────────────────────────────────────────────────
# Option A: Anthropic-compatible gateway (set base URL + token)
# LLM_BASE_URL=https://your-gateway.example.com
# RADICAL_GATEWAY_TOKEN=your_gateway_token_here

# Option B: Direct Anthropic API
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override model names (defaults to claude-sonnet/opus/haiku-4-5)
# LLM_MODEL_SONNET=claude-sonnet-4-5
# LLM_MODEL_OPUS=claude-opus-4-5
# LLM_MODEL_HAIKU=claude-haiku-4-5

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com
# Settings → API → Project URL + anon/public key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Supabase Google Auth ──────────────────────────────────────────────────────
# In Supabase dashboard: Authentication → Providers → Google
#   1. Enable Google provider
#   2. Go to console.cloud.google.com → Create OAuth 2.0 credentials
#   3. Set Authorized redirect URI to:
#      https://<your-project>.supabase.co/auth/v1/callback
#   4. Paste Client ID + Secret into Supabase dashboard (not this file)
#
# For local dev, also add to Supabase → Auth → URL Configuration:
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback
#
# No Google env vars needed here — Supabase handles them in its dashboard.

# ─── Strava OAuth 2.0 ──────────────────────────────────────────────────────────
# Register your app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Populated after first OAuth flow (stored server-side only)
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
STRAVA_TOKEN_EXPIRES_AT=

# Base URL used for OAuth callback (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Strava Webhooks ───────────────────────────────────────────────────────────
# Choose any secret string — must match what you pass when calling /api/strava/subscribe
STRAVA_WEBHOOK_VERIFY_TOKEN=your_verify_token_here

